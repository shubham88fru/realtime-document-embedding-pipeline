# Copy to .env.local and fill in. Every variable is validated at startup by
# src/lib/env.ts — a missing or malformed value fails the boot with a message
# naming the offender.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Deployment environment: development | staging | production
# Deliberately separate from NODE_ENV, which has no notion of staging.
APP_ENV=development

# Absolute base URL of the app. Must include the scheme.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Optional — pipeline limits (defaults shown)
# ---------------------------------------------------------------------------

# Files accepted in a single upload.
MAX_UPLOAD_FILES=10

# Per-file size ceiling, in megabytes.
MAX_FILE_SIZE_MB=5

# Documents embedded concurrently.
MAX_PROCESSING_CONCURRENCY=10

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Postgres with the pgvector extension. Required — the app refuses to boot
# without it. See README.md for the local container.
# Do not put connection_limit or pool_timeout here: the pool is sized in
# src/lib/db.ts from MAX_PROCESSING_CONCURRENCY.
DATABASE_URL=postgresql://dep:dep_local_dev@localhost:5432/document_embedding_pipeline?schema=public

# Used only by `npm run test:integration`, which truncates every table between
# test cases. Point it at a throwaway database, never at DATABASE_URL.
TEST_DATABASE_URL=postgresql://dep:dep_local_dev@localhost:5432/document_embedding_pipeline_test?schema=public

# ---------------------------------------------------------------------------
# Google authentication
# ---------------------------------------------------------------------------

# Encrypts the Auth.js session cookie. Generate with: openssl rand -base64 32
AUTH_SECRET=

# OAuth 2.0 web client credentials from Google Cloud Console. Configure this
# authorized redirect URI:
# http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---------------------------------------------------------------------------
# Object storage
# ---------------------------------------------------------------------------

# Local development uses the MinIO service from `npm run storage:start`.
AWS_REGION=us-east-1
S3_BUCKET_NAME=document-embedding-pipeline
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=depminio
AWS_SECRET_ACCESS_KEY=dep_local_storage

# In AWS, omit S3_ENDPOINT and static credentials, set
# S3_FORCE_PATH_STYLE=false, and use an IAM role.

# ---------------------------------------------------------------------------
# Added by later tickets — not read yet
# ---------------------------------------------------------------------------
# SQS_QUEUE_URL=             # 05 — processing queue
# OPENAI_API_KEY=            # 07 — embeddings
# OPENSEARCH_ENDPOINT=       # 08 — vector storage
